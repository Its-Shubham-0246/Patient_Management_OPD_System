# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# In production, use MongoDB Atlas URI with replica set: mongodb+srv://<user>:<password>@cluster0.mongodb.net/smart_opd?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smart_opd

# JWT Authentication
JWT_ACCESS_SECRET=smart_opd_super_secret_access_jwt_key_2026_dev_32chars
JWT_REFRESH_SECRET=smart_opd_super_secret_refresh_jwt_key_2026_dev_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Financial Authorization
CLINICAL_DISCOUNT_AUTH_PIN=1234

